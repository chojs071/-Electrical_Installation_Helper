# ── 로컬 개발 (npm run dev) ──
# ⚠️ VITE_ 변수는 브라우저 번들에 포함됩니다. 키는 로컬 dev용으로만 사용하세요.
VITE_AI_API_KEY=your_api_key_here
VITE_SUPABASE_URL=https://xxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_api_key

# 선택 사항
# VITE_AI_BASE_URL=/api/ai   # dev 프록시/Cloudflare Functions 경유 (권장: 비워두기)
# VITE_AI_MODEL=gemma4:31b-cloud
# VITE_VISION_MODEL=  # 이미지 설명 전담 모델 (미지정 시 VITE_AI_MODEL과 동일)
# AI_BASE_URL=https://ollama.com/v1   # dev 프록시의 upstream (VITE_ 없음, 로컬에서 프로바이더 교체용)

# ── Cloudflare Pages 배포 (대시보드 Settings > Environment variables) ──
# 빌드 시 포함 (Variables): VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
# 서버 전용 (Secrets, VITE_ 금지): AI_API_KEY
# 선택 (Variables): AI_BASE_URL (기본 https://ollama.com/v1), AI_MODEL (지정 시 클라이언트 모델보다 우선),
#   VISION_MODEL (이미지 설명 요청에만 우선 적용, 미지정 시 클라이언트 모델)
# 프로바이더 교체 예시 — OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-4o-mini
